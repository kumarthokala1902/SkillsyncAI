# Firebase client SDK configuration (safe for browser use)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK. Use a runtime-injected file path or inline JSON.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_REQUIRED=false

# Application and database settings
FLASK_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_URL=sqlite:///skillsync.db
HOST=0.0.0.0
PORT=5000

# Optional administrative bootstrap token
ADMIN_BOOTSTRAP_TOKEN=

# Docker Compose PostgreSQL settings
POSTGRES_DB=skillsync
POSTGRES_USER=skillsync
POSTGRES_PASSWORD=replace-with-a-long-random-value
APP_PORT=5000